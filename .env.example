# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=

# Админы бота: могут всё и раздают доступ остальным прямо из чата.
# Свой номер узнаешь командой /id. Несколько — через запятую.
BOT_ADMIN_IDS=6887373040

# Доступы, заданные жёстко. Обычно не нужны: проще выдавать из админки,
# такие доступы хранятся в state.json и переживают перезапуск.
BOT_ALLOWED_IDS=

# Прокси до Telegram. Нужен, только если сервер не ходит туда напрямую.
# Формат: socks5://user:pass@host:port или http://host:port
BOT_PROXY=

# ---- 2GIS ----
# Ключ Places API — https://platform.2gis.ru
DGIS_API_KEY=

# ---- Границы отбора ----
BOT_RATING_MIN=3.0
BOT_RATING_MAX=4.2
BOT_MIN_REVIEWS=10

# ---- Необязательное ----
# Ключ Яндекса «Поиск по организациям» — только для точных ссылок
# на карточки. Рейтинга в этом API нет. https://developer.tech.yandex.ru
YANDEX_API_KEY=
