# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=

# Кому можно пользоваться ботом. Свой номер узнаешь командой /id.
# Несколько — через запятую. Пока пусто, бот не пускает никого.
BOT_ALLOWED_IDS=

# Прокси до Telegram. Нужен, только если сервер не ходит туда напрямую.
# Формат: socks5://user:pass@host:port или http://host:port
BOT_PROXY=

# ---- 2GIS ----
# Ключ Places API — https://platform.2gis.ru
DGIS_API_KEY=

# ---- Границы отбора ----
BOT_RATING_MIN=3.0
BOT_RATING_MAX=4.2
BOT_MIN_REVIEWS=10

# ---- Необязательное ----
# Ключ Яндекса «Поиск по организациям» — только для точных ссылок
# на карточки. Рейтинга в этом API нет. https://developer.tech.yandex.ru
YANDEX_API_KEY=
